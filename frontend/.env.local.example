# Copy to frontend/.env.local
# Must match ORGANIZER_API_KEY in backend/.env
#
# Used only by the server-side Next.js upload proxy. The browser never sees it.
# Optional override if your backend is not running on localhost:8000:
# BACKEND_API_BASE_URL=https://spirituality-pcs-annotated-accounts.trycloudflare.com

ORGANIZER_API_KEY=change-me-to-a-long-random-string
BACKEND_API_BASE_URL=https://spirituality-pcs-annotated-accounts.trycloudflare.com
