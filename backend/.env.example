# Copy to backend/.env and fill in values before running the API.

# Required for organizer photo uploads (POST /events/{id}/photos).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ORGANIZER_API_KEY=change-me-to-a-long-random-string

# Comma-separated frontend origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000

# Database connection string.
# Dev default is SQLite if omitted.
# Example Postgres: postgresql+psycopg://user:pass@host:5432/event_face_match
DATABASE_URL=sqlite:///app.db

# Storage backend: local | r2 | cloudinary
STORAGE_BACKEND=local

# Signed URL TTL (seconds) for R2 download links
SIGNED_URL_TTL_SECONDS=900

# Thumbnail max edge length (pixels)
THUMBNAIL_SIZE=512

# R2 config (required only when STORAGE_BACKEND=r2)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cloudinary config (required only when STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_REQUEST=20

# Rate limit on the compute-heavy match endpoint (slowapi format)
MATCH_RATE_LIMIT=10/minute
